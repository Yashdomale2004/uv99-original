{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/QR", "destination": "https://uv99-qr.vercel.app/" },
    { "source": "/QR/", "destination": "https://uv99-qr.vercel.app/" },
    { "source": "/QR/:path*", "destination": "https://uv99-qr.vercel.app/:path*" }
  ]
}
